+    assert.match(html, /<base href="\/base\/restaurante\/" \/>/);
+    assert.match(html, /id="raiz"/);
+    assert.match(html, /assets\/catalogo-[^"]+\.js/);
+    assert.ok(html.indexOf("<base") < html.indexOf("<script"), "<base> va antes de cualquier recurso");
+  });
