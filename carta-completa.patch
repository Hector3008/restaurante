diff --git a/src/publico-http.js b/src/publico-http.js
new file mode 100644
index 0000000..7b935f3
--- /dev/null
+++ b/src/publico-http.js
@@ -0,0 +1,92 @@
+import { ErrorPedido } from "./errores.js";
+
+/**
+ * Rutas públicas del restaurante (SIN sesión): la carta de una empresa y el cliente que la mira.
+ *
+ *   GET /catalogo/:empresa              la página (HTML) de la carta; `:empresa` es el slug
+ *   GET /publico/:empresa/carta         { empresa: { nombre, slug, moneda }, categorias: [{ nombre, items }] }
+ *   GET /publico/:empresa/plato/:codigo  { empresa, plato: { codigo, nombre, categoria, precio, descripcion, imagen }, resenas }
+ *   GET /publico/:empresa/cliente       { demo, nombre, puntos, movimientos }   (cliente fijo por ahora)
+ *
+ * Solo lectura (GET), así que no necesitan `x-requested-with`. Como no hay sesión que limite el abuso, llevan
+ * un límite de frecuencia por IP, en memoria (como los de auth: se reinicia con el servidor y no se comparte
+ * entre instancias; ver sección 6).
+ */
+
+const VENTANA_MS = 60_000;
+const MAX_POR_VENTANA = 60;
+
+export function limitadorPorIp({ ventanaMs = VENTANA_MS, max = MAX_POR_VENTANA, ahora = Date.now } = {}) {
+  const cuentas = new Map(); // ip -> { desde, n }
+  return (req, res, next) => {
+    const t = ahora();
+    if (cuentas.size > 5000) for (const [ip, c] of cuentas) if (t - c.desde >= ventanaMs) cuentas.delete(ip);
+    const ip = req.ip ?? "desconocida";
+    let c = cuentas.get(ip);
+    if (!c || t - c.desde >= ventanaMs) {
+      c = { desde: t, n: 0 };
+      cuentas.set(ip, c);
+    }
+    c.n += 1;
+    if (c.n > max) {
+      res.setHeader("Retry-After", String(Math.ceil((c.desde + ventanaMs - t) / 1000)));
+      return res.status(429).json({ error: "Demasiadas consultas. Espera un momento.", codigo: "DEMASIADAS_CONSULTAS" });
+    }
+    next();
+  };
+}
+
+const escaparAttr = (s) => s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+
+/**
+ * La página vive en `<base>/restaurante/catalogo/<slug>`, una ruta más profunda que la del front de personal
+ * (`<base>/restaurante/`). Los archivos compilados se piden en relativo, así que se fija `<base href>` a la
+ * raíz del montaje: así el HTML sirve con cualquier BASE_PATH y api.js calcula bien la ruta de la API.
+ */
+export function paginaCatalogo(html, baseUrl) {
+  const base = `${baseUrl.replace(/\/+$/, "")}/`;
+  return html.replace("<head>", `<head>\n    <base href="${escaparAttr(base)}" />`);
+}
+
+export function montarRutasPublicas(router, publico, htmlCatalogo, limitador = limitadorPorIp()) {
+  const envolver = (fn) => async (req, res, next) => {
+    try {
+      await fn(req, res);
+    } catch (e) {
+      if (e instanceof ErrorPedido) return res.status(e.status).json({ error: e.message, codigo: e.codigo });
+      next(e);
+    }
+  };
+
+  router.get("/catalogo/:empresa", limitador, (req, res) => {
+    res.setHeader("Cache-Control", "no-cache");
+    res.type("html").send(paginaCatalogo(htmlCatalogo, req.baseUrl));
+  });
+
+  router.get(
+    "/publico/:empresa/carta",
+    limitador,
+    envolver(async (req, res) => {
+      res.setHeader("Cache-Control", "public, max-age=30");
+      res.status(200).json(await publico.carta({ slug: req.params.empresa }));
+    }),
+  );
+
+  router.get(
+    "/publico/:empresa/plato/:codigo",
+    limitador,
+    envolver(async (req, res) => {
+      res.setHeader("Cache-Control", "public, max-age=30");
+      res.status(200).json(await publico.plato({ slug: req.params.empresa, codigo: req.params.codigo }));
+    }),
+  );
+
+  router.get(
+    "/publico/:empresa/cliente",
+    limitador,
+    envolver(async (req, res) => {
+      res.setHeader("Cache-Control", "no-store");
+      res.status(200).json(await publico.cliente({ slug: req.params.empresa }));
+    }),
+  );
+}
diff --git a/src/publico.js b/src/publico.js
new file mode 100644
index 0000000..ead401a
--- /dev/null
+++ b/src/publico.js
@@ -0,0 +1,117 @@
+import { ErrorPedido } from "./errores.js";
+import { ErrorCatalogo } from "core";
+import { clienteActual } from "./cliente-demo.js";
+import { resenasDe } from "./resenas-demo.js";
+
+// Vista pública de la carta (sin sesión). La empresa se identifica por su `slug` (arquitectura 5.13: los pedidos
+// por QR serán una ruta pública con la empresa por slug). Solo se expone lo que un cliente puede ver:
+// nombre de la empresa, moneda y, de cada ítem ACTIVO del catálogo, código, nombre, categoría y precio; el detalle
+// de un plato suma su descripción y foto. Nunca el resto de `atributos` (son internos del servicio), ni ítems
+// desactivados, ni nada de pedidos o clientes reales.
+
+const SLUG = /^[a-z0-9][a-z0-9-]{0,59}$/;
+const SIN_CATEGORIA = "Otros";
+const TOPE_ITEMS = 1000; // la carta se lee por páginas de 200 (máximo de core.catalogo.listar)
+
+const noEncontrada = () => new ErrorPedido("NO_ENCONTRADO", "carta no encontrada");
+const platoNoEncontrado = () => new ErrorPedido("NO_ENCONTRADO", "plato no encontrado");
+
+// La descripción y la foto de un plato viven en los atributos del ítem: DESCRIPCION (texto) e IMAGEN (URL).
+// Solo esos dos campos salen al público, nunca el resto de `atributos`.
+export const CAMPOS_PLATO = { DESCRIPCION: "texto", IMAGEN: "texto" };
+
+/** Solo URLs https absolutas y sin credenciales: lo demás (javascript:, data:, http:, relativas) se descarta. */
+export function urlImagenSegura(valor) {
+  if (typeof valor !== "string" || valor.length > 500) return null;
+  try {
+    const u = new URL(valor.trim());
+    if (u.protocol !== "https:" || u.username || u.password) return null;
+    return u.href;
+  } catch {
+    return null;
+  }
+}
+
+const textoONulo = (v) => (typeof v === "string" && v.trim() ? v.trim() : null);
+
+/** Agrupa por categoría conservando el orden alfabético del catálogo; lo sin categoría va al final. */
+export function agruparPorCategoria(items) {
+  const grupos = new Map();
+  for (const i of items) {
+    const nombre = i.categoria?.trim() ? i.categoria.trim() : SIN_CATEGORIA;
+    if (!grupos.has(nombre)) grupos.set(nombre, []);
+    grupos.get(nombre).push({ codigo: i.codigo, nombre: i.nombre, precio: i.precio ?? null });
+  }
+  const lista = [...grupos].map(([nombre, its]) => ({ nombre, items: its }));
+  lista.sort((a, b) => {
+    if (a.nombre === SIN_CATEGORIA) return b.nombre === SIN_CATEGORIA ? 0 : 1;
+    if (b.nombre === SIN_CATEGORIA) return -1;
+    return a.nombre.localeCompare(b.nombre, "es");
+  });
+  return lista;
+}
+
+export function crearPublico(core) {
+  /**
+   * Empresa pública por slug: debe existir, estar activa y tener el servicio `restaurante` activo.
+   * Todos los casos de rechazo dan el mismo 404: no se revela qué empresas existen.
+   */
+  async function empresaPorSlug(slug) {
+    if (typeof slug !== "string" || !SLUG.test(slug)) throw noEncontrada();
+    // Empresa es un modelo global (sin tenancy): se consulta sin empresa activa.
+    const e = await core.modelos.Empresa.findOne({ slug }).lean();
+    if (!e || e.activa === false) throw noEncontrada();
+    const sirve = (e.servicios ?? []).some((s) => s.codigo === "restaurante" && s.activa !== false);
+    if (!sirve) throw noEncontrada();
+    return e;
+  }
+
+  async function carta({ slug }) {
+    const e = await empresaPorSlug(slug);
+    const empresaId = e._id;
+    const items = [];
+    for (let saltar = 0; saltar < TOPE_ITEMS; saltar += 200) {
+      const pagina = await core.catalogo.listar({ empresaId, limite: 200, saltar });
+      items.push(...pagina);
+      if (pagina.length < 200) break;
+    }
+    return {
+      empresa: { nombre: e.nombre, slug: e.slug, moneda: e.moneda ?? "PEN" },
+      categorias: agruparPorCategoria(items),
+    };
+  }
+
+  /** Un plato (ítem activo) con descripción y foto opcionales, y sus reseñas (de ejemplo, solo texto). */
+  async function plato({ slug, codigo }) {
+    const e = await empresaPorSlug(slug);
+    let i;
+    try {
+      i = await core.catalogo.obtener({ empresaId: e._id, codigo });
+    } catch (err) {
+      if (err instanceof ErrorCatalogo) throw platoNoEncontrado();
+      throw err;
+    }
+    if (i.activo === false) throw platoNoEncontrado();
+    const a = i.atributos ?? {};
+    return {
+      empresa: { nombre: e.nombre, slug: e.slug, moneda: e.moneda ?? "PEN" },
+      plato: {
+        codigo: i.codigo,
+        nombre: i.nombre,
+        categoria: i.categoria ?? null,
+        precio: i.precio ?? null,
+        descripcion: textoONulo(a.DESCRIPCION),
+        imagen: urlImagenSegura(a.IMAGEN),
+      },
+      resenas: resenasDe(),
+    };
+  }
+
+  /** El cliente y sus puntos. Hoy es un cliente fijo (cliente-demo.js); la empresa solo se valida. */
+  async function cliente({ slug }) {
+    const e = await empresaPorSlug(slug);
+    return clienteActual({ empresa: e.slug });
+  }
+
+  return { carta, plato, cliente, empresaPorSlug };
+}
diff --git a/src/resenas-demo.js b/src/resenas-demo.js
new file mode 100644
index 0000000..88d0c51
--- /dev/null
+++ b/src/resenas-demo.js
@@ -0,0 +1,16 @@
+// Reseñas de EJEMPLO para la tarjeta de detalle del plato. Provisional, igual que cliente-demo.js: todavía no
+// hay identidad del cliente final ni dónde guardar reseñas. Solo texto y estrellas: sin imágenes ni videos
+// (decisión de producto). Las mismas para todos los platos; la respuesta lleva `demo: true` y la página lo avisa.
+// Cuando existan reseñas reales, solo se reemplaza `resenasDe()`.
+
+const BASE = Object.freeze([
+  Object.freeze({ autor: "Camila R.", estrellas: 5, texto: "Muy bien preparado y llegó caliente. Repito siempre.", ts: "2026-10-10T14:00:00.000Z" }),
+  Object.freeze({ autor: "Diego M.", estrellas: 4, texto: "Muy rico, aunque en hora punta tardó un poco.", ts: "2026-10-06T19:30:00.000Z" }),
+  Object.freeze({ autor: "Lucía P.", estrellas: 5, texto: "La porción es generosa y el precio justo.", ts: "2026-09-29T13:15:00.000Z" }),
+]);
+
+export function resenasDe() {
+  const resenas = BASE.map((r) => ({ ...r }));
+  const suma = resenas.reduce((n, r) => n + r.estrellas, 0);
+  return { demo: true, total: resenas.length, promedio: Math.round((suma / resenas.length) * 10) / 10, resenas };
+}
