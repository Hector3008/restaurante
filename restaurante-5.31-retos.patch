diff --git a/client/src/catalogo/logica.js b/client/src/catalogo/logica.js
index 84dc9f2..0a29bd2 100644
--- a/client/src/catalogo/logica.js
+++ b/client/src/catalogo/logica.js
@@ -132,3 +132,20 @@ export function textoVence(venceTs, ahora = new Date()) {
 }
 
 export const ESTADO_VALE = { usado: "Usado", cancelado: "Cancelado", vencido: "Vencido" };
+
+// ---------- retos de colección (5.31) ----------
+
+/** «2 de 5 cafés»: lo probado sobre el total del reto. */
+export const textoAvance = (r) => `${r?.logrados ?? 0} de ${r?.total ?? 0}`;
+
+/** Lo que falta por probar, para decirlo en una línea: «Te faltan: Moka y Cortado». */
+export function textoFaltan(faltan) {
+  const nombres = (Array.isArray(faltan) ? faltan : []).map((i) => i.nombre ?? i.codigo).filter(Boolean);
+  if (!nombres.length) return "";
+  if (nombres.length === 1) return `Te falta: ${nombres[0]}`;
+  if (nombres.length <= 4) return `Te faltan: ${nombres.slice(0, -1).join(", ")} y ${nombres.at(-1)}`;
+  return `Te faltan ${nombres.length}: ${nombres.slice(0, 3).join(", ")}…`;
+}
+
+/** Porcentaje (0 a 100) de avance de un reto. */
+export const porcentajeReto = (r) => (r?.total > 0 ? Math.round(((r.logrados ?? 0) / r.total) * 100) : 0);
diff --git a/src/fuente-puntos.js b/src/fuente-puntos.js
new file mode 100644
index 0000000..a835aa0
--- /dev/null
+++ b/src/fuente-puntos.js
@@ -0,0 +1,13 @@
+// De un ítem pagado: a quién se le acumulan los puntos, cuánto, y qué plato era (arquitectura 5.27 y 5.31).
+// `d` es el documento `doc_item` que devuelve core.documentos.obtener.
+export function extraerConsumo(d) {
+  const item = d.snapshot?.item;
+  return {
+    clienteId: d.snapshot?.cliente?.clienteId ?? null,
+    monto: d.payload?.doc?.subtotal ?? null,
+    detalle: d.payload?.doc?.pedidoCode ? `Pedido ${d.payload.doc.pedidoCode} pagado` : "Pedido pagado",
+    // El plato del catálogo que se pagó: con esto el núcleo sabe qué cafés probó el cliente (retos, 5.31).
+    // Las líneas libres no cuentan: no son un plato de la carta.
+    itemCodigo: item?.origen === "catalogo" ? item.codigo ?? null : null,
+  };
+}
